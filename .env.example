# Optional Supabase sync: disabled unless explicitly set to true.
VITE_ENABLE_SUPABASE_SYNC=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional YOLOv8-style ONNX detector. Empty model URL keeps the classical OpenCV/RVI screw path; custom component classes require a compatible YOLO model and matching labels.
VITE_YOLO_MODEL_URL=
VITE_YOLO_INPUT_SIZE=640
VITE_YOLO_CONFIDENCE=0.35
VITE_YOLO_IOU=0.45
VITE_YOLO_CLASS_NAMES=screw,fastener,bolt
VITE_YOLO_SCREW_CLASS_NAMES=screw,fastener,bolt
